{
  // Typecheck facade for the browser half (src/client). noEmit BY DESIGN: the
  // JS emit is tsdown's job (it bundles src/client/index.ts directly, reading
  // `jsx` from the package tsconfig).
  //
  // ADR-0005 anchor bump (dsh-v0.2.1-alpha.1): the /client type imports now
  // resolve through node_modules — the alpha.1 dists declare every subpath we
  // import (./client) with lib/types declarations — so no paths map is needed
  // at all. The options port the upstream base client facade.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "composite": false,
    "incremental": false
  },
  "include": [
    "src/client"
  ]
}
