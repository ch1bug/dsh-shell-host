{
  "name": "dsh-shell-host",
  "version": "0.2.1-rc.2-r1",
  "private": true,
  "description": "dsh-shell-host: tools-only DSH plugin (ADR-0013) — persistent PTY sessions (./pty), interactive ssh sessions (./ssh), launcher-preset terminals (shell_open, ./terminal), and WSL bridge tools (./wsl). No shell executor, no upstream loader-row takeover.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pty",
    "terminal",
    "windows"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": "~0.2.1-rc.1"
  },
  "main": "lib/pty/index.js",
  "types": "lib/types/pty/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/pty/index.d.ts",
      "default": "./lib/pty/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./pty": {
      "types": "./lib/types/pty/index.d.ts",
      "default": "./lib/pty/index.js"
    },
    "./ssh": {
      "types": "./lib/types/ssh/index.d.ts",
      "default": "./lib/ssh/index.js"
    },
    "./wsl": {
      "types": "./lib/types/wsl-plugin/index.d.ts",
      "default": "./lib/wsl-plugin/index.js"
    },
    "./terminal": {
      "types": "./lib/types/terminal/index.d.ts",
      "default": "./lib/terminal/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/types/remote/index.d.ts",
      "default": "./lib/remote/index.js"
    },
    "./remote-fs": {
      "types": "./lib/types/remote-fs/index.d.ts",
      "default": "./lib/remote-fs/index.js"
    }
  },
  "files": [
    "lib/types/**/*.d.ts",
    "lib/pty/index.js",
    "lib/pty-*.js",
    "lib/ssh/index.js",
    "lib/wsl-plugin/index.js",
    "lib/terminal/index.js",
    "lib/client.js",
    "lib/remote/index.js",
    "lib/remote-fs/index.js",
    "lib/permission-gate-*.js",
    "lib/posix-quote-*.js",
    "lib/detect-*.js",
    "lib/launchers-*.js",
    "lib/tool-support-*.js",
    "lib/compose-*.js",
    "lib/transport-*.js",
    "lib/service-*.js",
    "lib/src-*.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:pack": "node scripts/verify-pack.mjs",
    "test:release": "node --run build && node --run verify:pack",
    "test": "node --run typecheck && node scripts/verify-all.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@lydell/node-pty": "1.2.0-beta.15",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/cosmokit": "~1.8.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^24",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  }
}
