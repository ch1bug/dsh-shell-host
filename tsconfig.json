{
  // Self-contained resolution + typecheck facade for src and tests (issue #23,
  // AC3/AC4): no `extends` into an upstream monorepo checkout — every
  // @deepseek-ai/* specifier resolves to the npm-published BUILT declarations
  // through node_modules (devDependencies). Drift policy: this file carries
  // the union of the relaxations upstream's vendor/ packages declare (cordis's
  // set; the others are subsets); our own src/tests stay authored to full base
  // strictness. skipLibCheck is on because the npm declarations are consumed
  // across package boundaries (each upstream package compiled under its own
  // stricter-than-ours facade).
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    // The browser half (src/client) is bundled by tsdown, whose oxc transform
    // reads these two options for the TSX files; they are inert for the host
    // facade's own sources (no JSX there).
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // See the drift-policy note above: the union of upstream vendor relaxations.
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictFunctionTypes": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src",
    "tests",
    "vitest.config.ts",
    "tsdown.config.ts"
  ],
  // The browser half has its own facade (tsconfig.client.json).
  "exclude": [
    "src/client"
  ]
}
