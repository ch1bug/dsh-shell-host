{
  // Declaration emit mirroring upstream packaging: lib/types/index.d.ts for
  // the published types face. Runtime JS is bundled separately by tsdown.
  // `paths` is cleared ON PURPOSE in this config: the typecheck facade maps
  // @deepseek-ai/* to upstream SOURCE, but emit must resolve them as
  // EXTERNAL declaration files (upstream's own project-reference pattern) —
  // node_modules link: entries point at the monorepo checkout, whose
  // lib/types/*.d.ts are built first by the build script's `tsc -b` step.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    "outDir": "lib/types",
    "rootDir": "src",
    "paths": {}
  },
  "include": [
    "src"
  ]
}
