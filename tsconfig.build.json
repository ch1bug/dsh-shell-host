{
  // Declaration emit mirroring upstream packaging: lib/types/index.d.ts for
  // the published types face. Runtime JS is bundled separately by tsdown.
  // `paths` stays cleared: the typecheck facade resolves @deepseek-ai/*
  // through node_modules (published dist declarations), and emit must see
  // them as EXTERNAL declaration files. Since the ADR-0005 anchor bump
  // (dsh-v0.2.1-alpha.1) no upstream `tsc -b` pre-pass is needed — the dists
  // ship built lib/types in the tarballs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    "outDir": "lib/types",
    "rootDir": "src",
    "paths": {}
  },
  "include": [
    "src"
  ]
}
